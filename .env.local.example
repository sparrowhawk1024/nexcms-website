# ─────────────────────────────────────────────────────────────
# NexCMS – environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# Contentstack Delivery API credentials
# Found in: Contentstack → Settings → Stack → API Keys
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=development

# On-demand revalidation secret
# Set the same value as a query param in your Contentstack webhook URL:
#   https://your-domain.com/api/revalidate?secret=<this value>
REVALIDATE_SECRET=
