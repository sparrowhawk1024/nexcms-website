# ─────────────────────────────────────────────────────────────
# NexCMS – environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Contentstack Delivery API credentials ─────────────────────
# Found in: Contentstack → Settings → Stack → API Keys
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=development

# ── Contentstack Deployment Webhook Secret ────────────────────
# Used by /api/revalidate to verify that incoming webhook calls
# are genuinely from Contentstack and not from random crawlers.
#
# SETUP:
#   1. Pick any random string (e.g. run: openssl rand -hex 32)
#   2. Paste it here
#   3. In Contentstack: Settings → Webhooks → Create Webhook
#      URL:    https://your-domain.com/api/revalidate
#      Header: x-webhook-secret  →  <same value as below>
#      Trigger: Entry Published / Entry Unpublished / Entry Deleted
#   4. Add this same value to Vercel/Netlify environment variables
#
CONTENTSTACK_WEBHOOK_SECRET=

# ── Legacy revalidation secret (kept for backwards compat) ────
REVALIDATE_SECRET=
